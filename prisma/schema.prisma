// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperatorRole {
  admin
  agent
}

enum LeadKind {
  contact
  devis
  reservation
}

enum LeadStatus {
  new
  pending
  accepted
  refused
  processed
  archived
  scheduled
  completed
  cancelled
  expired
  cancellation_requested
}

enum StripeOnboardingStatus {
  NOT_STARTED
  PENDING
  RESTRICTED
  COMPLETE
}

enum TenantPaymentMode {
  FULL
  DEPOSIT
}

enum PaymentProvider {
  STRIPE
}

enum PaymentMode {
  FULL
  DEPOSIT
}

enum PaymentStatus {
  PENDING
  LINK_SENT
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUND_FAILED
}

enum PlatformAdminRole {
  OWNER
  ADMIN
  READONLY
}

enum LeadPaymentStatus {
  NONE
  PENDING
  LINK_SENT
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUND_FAILED
}

/// Statut d'un remboursement Stripe (miroir de Refund.status).
enum RefundStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum RefundInitiator {
  OPERATOR
  STRIPE_DASHBOARD
  SYSTEM
}

enum CancellationRequestStatus {
  PENDING
  ACCEPTED
  REFUSED
  MANUAL
}

enum TenantDomainStatus {
  active
  pending
  rejected
  archived
}

enum TenantDomainSource {
  manual
  observed_origin
  settings
  env
}

model Tenant {
  id                           String                 @id
  name                         String
  slug                         String                 @unique
  active                       Boolean                @default(true)
  configRef                    String?
  /// Paramètres vitrine / dashboard (JSON). Aucun secret ne doit y être stocké.
  settings                     Json?
  /// Compte Stripe Connect Express du VTC (acct_...).
  stripeAccountId              String?                @unique
  stripeChargesEnabled         Boolean                @default(false)
  stripePayoutsEnabled         Boolean                @default(false)
  stripeDetailsSubmitted       Boolean                @default(false)
  stripeOnboardingStatus       StripeOnboardingStatus @default(NOT_STARTED)
  paymentOnlineEnabled         Boolean                @default(false)
  paymentMode                  TenantPaymentMode      @default(FULL)
  /// Acompte en pourcentage (1–100) si paymentMode = DEPOSIT et règle %.
  depositPercent               Int?
  /// Acompte en centimes si paymentMode = DEPOSIT et règle fixe.
  depositFixedAmount           Int?
  /// Devise ISO (V1 : eur).
  paymentCurrency              String                 @default("eur")
  /// Commission plateforme en centimes (ex. 500 = 5 €). Non modifiable par le VTC via l’API publique.
  platformApplicationFeeAmount Int                    @default(500)
  /// Politique d'annulation configurable par le VTC (JSON validé côté API, aucune donnée sensible).
  cancellationPolicy           Json?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  users                        OperatorUser[]
  leads                        LeadRequest[]
  statusHistory                LeadStatusHistory[]
  authSessions                 AuthSession[]
  payments                     Payment[]
  domains                      TenantDomain[]
  paymentRefunds               PaymentRefund[]
  cancellationRequests         CancellationRequest[]
  bookingAccessTokens          BookingAccessToken[]
}

model TenantDomain {
  id              String             @id @default(cuid())
  tenantId        String?
  domain          String             @unique
  canonicalDomain Boolean            @default(false)
  status          TenantDomainStatus @default(pending)
  source          TenantDomainSource @default(manual)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status, lastSeenAt(sort: Desc)])
  @@index([domain])
}

model OperatorUser {
  id           String              @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         OperatorRole        @default(agent)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     AuthSession[]
  changedLeads LeadStatusHistory[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model LeadRequest {
  id                            String                @id @default(cuid())
  tenantId                      String
  kind                          LeadKind
  status                        LeadStatus
  clientName                    String
  clientPhone                   String
  clientEmail                   String
  rawPayload                    Json
  flatPayload                   Json
  pricingResult                 Json?
  sourceSite                    String?
  scheduledStart                DateTime?
  scheduledEnd                  DateTime?
  acceptedAt                    DateTime?
  refusedAt                     DateTime?
  operatorNote                  String?
  emailSentAt                   DateTime?
  emailError                    String?
  /// Dernier accusé / notification envoyé au client suite à une décision opérateur (acceptation / refus).
  customerDecisionMailSentAt    DateTime?
  customerDecisionMailLastError String?
  /// Miroir simple pour l’UI ; source de vérité : enregistrements Payment.
  paymentStatus                 LeadPaymentStatus     @default(NONE)
  /// Souhaite recevoir un lien de paiement en ligne après acceptation (formulaires publics).
  clientWantsOnlinePayment      Boolean               @default(false)
  /// Version de la politique d'annulation en vigueur à la réservation (jamais réécrite rétroactivement).
  cancellationPolicySnapshot    Json?
  cancelledAt                   DateTime?
  cancellationReason            String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  tenant                        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  history                       LeadStatusHistory[]
  payments                      Payment[]
  paymentRefunds                PaymentRefund[]
  cancellationRequests          CancellationRequest[]
  bookingAccessTokens           BookingAccessToken[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, kind, status])
  @@index([tenantId, scheduledStart])
}

model Payment {
  id                           String          @id @default(cuid())
  tenantId                     String
  leadRequestId                String
  status                       PaymentStatus   @default(PENDING)
  provider                     PaymentProvider @default(STRIPE)
  mode                         PaymentMode
  /// Montant facturé au client, en centimes.
  amount                       Int
  currency                     String
  /// Commission plateforme en centimes, figée à la création.
  applicationFeeAmount         Int
  /// Compte connecté Stripe utilisé pour la transaction (acct_...).
  stripeAccountId              String
  stripeCheckoutSessionId      String?         @unique
  stripePaymentIntentId        String?         @unique
  stripePaymentLinkUrl         String?
  /// URL du reçu hébergé par Stripe (Charge.receipt_url), si disponible.
  stripeReceiptUrl             String?
  /// Charge Stripe (ch_...) sur le compte connecté, renseignée à la première opération de remboursement/synchro.
  stripeChargeId               String?
  /// Application fee Stripe (fee_...) liée à la charge (commission plateforme réelle).
  stripeApplicationFeeId       String?
  checkoutExpiresAt            DateTime?
  paidAt                       DateTime?
  failedAt                     DateTime?
  refundedAt                   DateTime?
  /// Cumul des remboursements Stripe confirmés (status succeeded), en centimes.
  refundedAmount               Int             @default(0)
  /// Cumul de commission plateforme restituée par Stripe, en centimes.
  applicationFeeRefundedAmount Int             @default(0)
  refundsSyncedAt              DateTime?
  /// Politique d'annulation affichée au client au moment du paiement.
  cancellationPolicySnapshot   Json?
  metadata                     Json?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  tenant                       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadRequest                  LeadRequest     @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)
  refunds                      PaymentRefund[]

  @@index([tenantId, leadRequestId])
  @@index([tenantId, createdAt(sort: Desc)])
}

/// Remboursement Stripe d'un paiement (direct charge sur compte connecté).
model PaymentRefund {
  id                           String          @id @default(cuid())
  tenantId                     String
  paymentId                    String
  leadRequestId                String
  /// Identifiant fourni par le client pour dédupliquer double clic / nouvel essai (unique par paiement).
  clientRequestId              String
  /// Clé d'idempotence Stripe persistante : réutilisée telle quelle à chaque nouvel essai.
  idempotencyKey               String          @unique
  stripeRefundId               String?         @unique
  stripePaymentIntentId        String?
  stripeChargeId               String?
  stripeAccountId              String
  /// Montant demandé, en centimes.
  amount                       Int
  currency                     String
  status                       RefundStatus    @default(PENDING)
  reason                       String?
  reasonNote                   String?
  failureReason                String?
  initiatedBy                  RefundInitiator @default(OPERATOR)
  initiatedByUserId            String?
  /// Commission plateforme attendue (calcul proportionnel) au moment de la demande.
  applicationFeeRefundExpected Int             @default(0)
  /// Commission plateforme réellement restituée (lue sur Stripe après confirmation).
  applicationFeeRefunded       Int             @default(0)
  notifiedInitiatedAt          DateTime?
  notifiedSucceededAt          DateTime?
  notifiedFailedAt             DateTime?
  lastSyncedAt                 DateTime?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  tenant                       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment                      Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  leadRequest                  LeadRequest     @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@unique([paymentId, clientRequestId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([paymentId])
  @@index([tenantId, status])
}

/// Demande d'annulation exprimée par le client via son lien sécurisé.
model CancellationRequest {
  id                 String                    @id @default(cuid())
  tenantId           String
  leadRequestId      String
  status             CancellationRequestStatus @default(PENDING)
  reason             String
  /// Statut de la demande avant la demande d'annulation (restauré si refus / traitement manuel).
  previousLeadStatus LeadStatus
  resolutionNote     String?
  resolvedByUserId   String?
  requestedAt        DateTime                  @default(now())
  resolvedAt         DateTime?
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadRequest        LeadRequest               @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([leadRequestId])
}

/// Jeton d'accès client (hash SHA-256 uniquement) lié à une réservation, expirant.
model BookingAccessToken {
  id            String      @id @default(cuid())
  tenantId      String
  leadRequestId String
  tokenHash     String      @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadRequest   LeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([expiresAt])
}

/// Événements Stripe déjà traités (idempotence webhook, clé = event.id Stripe evt_...).
model StripeWebhookEvent {
  id              String   @id @default(cuid())
  stripeEventId   String   @unique
  /// Compte connecté à l'origine de l'événement (acct_...), si événement Connect.
  stripeAccountId String?
  type            String
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

model LeadStatusHistory {
  id              String        @id @default(cuid())
  leadId          String
  tenantId        String
  previousStatus  LeadStatus?
  newStatus       LeadStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime      @default(now())
  lead            LeadRequest   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changedByUser   OperatorUser? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([leadId, createdAt(sort: Desc)])
}

model AuthSession {
  id               String       @id @default(cuid())
  tenantId         String
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  revokedAt        DateTime?
  replacedById     String?
  ip               String?
  userAgent        String?
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             OperatorUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

model PlatformAdminUser {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String?
  role         PlatformAdminRole @default(OWNER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lastLoginAt  DateTime?

  @@index([role])
  @@index([createdAt(sort: Desc)])
}

model PlatformEvent {
  id             String   @id @default(cuid())
  tenantId       String?
  observedDomain String?
  origin         String?
  type           String
  category       String?
  path           String?
  referrer       String?
  sessionId      String?
  visitorId      String?
  ipHash         String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([observedDomain, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
