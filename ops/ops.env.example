# Copier en ops.env (même dossier que les scripts) et ajuster. Aucune valeur secrète ici.

VTC_ROOT=/opt/vtc
CLIENTS_DIR=/opt/vtc/clients

# Conteneurs existants sur le VPS
API_CONTAINER=vtc-api
NGINX_CONTAINER=downpricer-nginx
# Réseau Docker partagé avec Nginx (celui de /opt/vtc/docker-compose.yml)
NGINX_NETWORK=vtc_default

# URL publique de l'API (figée dans chaque front au build)
API_PUBLIC_URL=https://api.sitereadyshd.fr

# Front : dépôt (défaut : remote de /opt/vtc/vtcfront) et version déployée par défaut
FRONT_REPO_URL=
FRONT_REF=main

# .env du site modèle : SMTP & co sont copiés dans chaque client
TEMPLATE_ENV=/opt/vtc/vtcfront/.env.local

# Mémoire max par site client
CLIENT_MEM_LIMIT=512m

# Nginx : dossiers hôte montés dans le conteneur (conf.d et ssl/acme). Vide = conf seulement écrite dans un fichier.
NGINX_CONF_DIR=/opt/downpricer/nginx/conf.d
NGINX_ACME_DIR=/opt/downpricer/nginx/ssl/acme
# NGINX_RELOAD_CMD="docker exec downpricer-nginx nginx -s reload"

# SSL : commande exécutée après la conf HTTP ; {DOMAIN} est remplacé. Vide = à faire à la main.
# À CONFIRMER sur le VPS : les certificats de tes autres sites sont dans ssl/live/<domaine>/, format certbot.
CERTBOT_CMD="sudo certbot certonly --webroot -w /opt/downpricer/nginx/ssl/acme --config-dir /opt/downpricer/nginx/ssl -d {DOMAIN} -d www.{DOMAIN}"
